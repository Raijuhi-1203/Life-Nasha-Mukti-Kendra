<%@ Page Language="C#" MasterPageFile="~/MasterPage.master" AutoEventWireup="true" CodeFile="service.aspx.cs" Inherits="service" %>

<asp:Content ID="Content1" ContentPlaceHolderID="ContentPlaceHolder1" runat="Server">


         <!--Page Title-->
         <section class="page-title" style="background-image: url(images/background/7.jpg)">
             <div class="auto-container">
                 <h1>Service</h1>
                 <ul class="page-breadcrumb">
                     <li><a href="index.aspx">Home</a></li>
                     <li>Service</li>
                 </ul>
             </div>
         </section>
         <!--End Page Title-->
    
       <!--Services Section-->
    <section class="services-page-section">
    	<div class="auto-container">
        	<div class="row clearfix">
            
            	<!--Services Block Two-->
                <div class="services-block-two col-md-4 col-sm-6 col-xs-12">
                	<div class="inner-box">
                    	<div class="image">
                        	<img src="images/resource/services-5.jpg" alt="" />
                            <div class="overlay">
                            	<a id="contactlink" runat="server" class="theme-btn btn-style-five">Contact Us</a>
                            </div>
                        </div>
                        <div class="lower-box">
                        	<h3><a href="#">Individual and group counseling</a></h3>
                            <div class="text">Counseling is a vital part of the rehabilitation process for individuals recovering from addiction. Both individual and group counseling play significant roles in helping individuals address the root causes of their substance abuse, develop coping mechanisms, and build a foundation for long-term recovery.</div>
                        </div>
                    </div>
                </div>
                
                <!--Services Block Two-->
                <div class="services-block-two col-md-4 col-sm-6 col-xs-12">
                	<div class="inner-box">
                    	<div class="image">
                        	<img src="images/resource/services-6.jpg" alt="" />
                            <div class="overlay">
                            	<a id="contactlink2" runat="server" class="theme-btn btn-style-five">Contact Us</a>
                            </div>
                        </div>
                        <div class="lower-box">
                        	<h3><a href="#">Detoxification</a></h3>
                            <div class="text">Detoxification, commonly referred to as detox, is the process of removing toxic substances, such as drugs or alcohol, from the body. It is the first and often one of the most critical steps in the journey to recovery for individuals struggling with substance abuse.</div>
                        </div>
                    </div>
                </div>
                
                <!--Services Block Two-->
                <div class="services-block-two col-md-4 col-sm-6 col-xs-12">
                	<div class="inner-box">
                    	<div class="image">
                        	<img src="images/resource/services-3.jpg" alt="" />
                            <div class="overlay">
                            	<a id="contactlink3" runat="server" class="theme-btn btn-style-five">Contact Us</a>
                            </div>
                        </div>
                        <div class="lower-box">
                        	<h3><a href="#">Behavioral Therapies</a></h3>
                            <div class="text">Behavioral therapies are a cornerstone of addiction treatment, focusing on addressing the psychological, emotional, and behavioral aspects of substance use. These evidence-based approaches help individuals identify harmful behaviors, develop healthier coping strategies, and maintain long-term recovery.</div>
                        </div>
                    </div>
                </div>
                
                <!--Services Block Two-->
                <div class="services-block-two col-md-4 col-sm-6 col-xs-12">
                	<div class="inner-box">
                    	<div class="image">
                        	<img src="images/resource/services-4.jpg" alt="" />
                            <div class="overlay">
                            	<a id="contactlink4" runat="server" class="theme-btn btn-style-five">Contact Us</a>
                            </div>
                        </div>
                        <div class="lower-box">
                        	<h3><a href="#">Life skills training</a></h3>
                            <div class="text">Life skills training is an essential component of rehabilitation programs, equipping individuals with practical tools and strategies to navigate daily challenges, maintain sobriety, and lead fulfilling lives. Addiction often disrupts the development or application of basic life skills, and training helps bridge these gaps to promote independence and confidence in recovery.</div>
                        </div>
                    </div>
                </div>
                
                <!--Services Block Two-->
                <div class="services-block-two col-md-4 col-sm-6 col-xs-12">
                	<div class="inner-box">
                    	<div class="image">
                        	<img src="images/resource/services-1.jpg" alt="" />
                            <div class="overlay">
                            	<a id="contactlink5" runat="server" class="theme-btn btn-style-five">Contact Us</a>
                            </div>
                        </div>
                        <div class="lower-box">
                        	<h3><a href="#">Yoga and meditation</a></h3>
                            <div class="text">Yoga and meditation are integral components of many rehabilitation programs, offering holistic tools to support recovery from addiction. These practices promote physical health, mental clarity, emotional balance, and spiritual growth, making them valuable for individuals on the path to sobriety.</div>
                        </div>
                    </div>
                </div>
                
                <!--Services Block Two-->
                <div class="services-block-two col-md-4 col-sm-6 col-xs-12">
                	<div class="inner-box">
                    	<div class="image">
                        	<img src="images/resource/services-2.jpg" alt="" />
                            <div class="overlay">
                            	<a id="contactlink6" runat="server" class="theme-btn btn-style-five">Contact Us</a>
                            </div>
                        </div>
                        <div class="lower-box">
                        	<h3><a href="#">Relapse prevention strategies</a></h3>
                            <div class="text">Relapse prevention is a critical component of addiction treatment, focusing on equipping individuals with the tools and strategies needed to maintain sobriety after rehab. By addressing the triggers, stressors, and habits that lead to relapse, these strategies empower individuals to navigate life's challenges without turning to substances.</div>
                        </div>
                    </div>
                </div>
                
            </div>
        </div>
    </section>
    <!--End Services Section-->


    
